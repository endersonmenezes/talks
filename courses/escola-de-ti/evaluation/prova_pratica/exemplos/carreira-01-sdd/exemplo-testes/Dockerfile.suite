# Roda a suíte do professor contra o código GERADO — em container, independente
# da máquina do professor. O build context é a pasta carreira-01-sdd/ (ver compose),
# por isso a suíte enxerga ../exemplo-codigo-gerado/app dentro da imagem.
FROM python:3.11-slim

WORKDIR /suite
RUN pip install --no-cache-dir pytest requests
COPY exemplo-testes/suite_professor.py exemplo-testes/run_suite.py ./
COPY exemplo-codigo-gerado/app /app-gerado

ENV APP_DIR=/app-gerado
CMD ["python", "run_suite.py"]
